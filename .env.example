# Copy this file to .env (in the repo root, or in backend/) and fill in your real key.
# .env is gitignored — never commit real secrets.

MISTRAL_API_KEY=your-mistral-api-key-here

# Optional overrides — these defaults already match the free-tier models.
MISTRAL_CHAT_MODEL=ministral-8b-latest
MISTRAL_MODERATION_MODEL=mistral-moderation-latest

# Model Evaluation feature: sign up for a free Phoenix Cloud space at
# https://app.phoenix.arize.com, generate an API key, and copy your space's
# base URL (shown on the space dashboard, looks like
# https://app.phoenix.arize.com/s/<your-space-name>).
PHOENIX_API_KEY=your-phoenix-api-key-here
PHOENIX_BASE_URL=https://app.phoenix.arize.com/s/your-space-name
# Optional - defaults to the project this feature's own traces land in.
# Only override if you want the "View in Phoenix" link to point elsewhere
# (find a project's id in its Phoenix URL: /projects/<id>/spans).
# PHOENIX_PROJECT_ID=UHJvamVjdDo0
