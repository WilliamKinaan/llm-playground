# Copy this file to .env (in the repo root, or in backend/) and fill in your real key.
# .env is gitignored — never commit real secrets.

MISTRAL_API_KEY=your-mistral-api-key-here

# Optional overrides — these defaults already match the free-tier models.
MISTRAL_CHAT_MODEL=ministral-8b-latest
MISTRAL_MODERATION_MODEL=mistral-moderation-latest
