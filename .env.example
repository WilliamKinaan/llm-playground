# Copy this file to .env (in the repo root, or in backend/) and fill in your real key.
# .env is gitignored — never commit real secrets.

MISTRAL_API_KEY=your-mistral-api-key-here

# Optional overrides — these defaults already match the free-tier models.
MISTRAL_CHAT_MODEL=ministral-8b-latest
MISTRAL_MODERATION_MODEL=mistral-moderation-latest

# In-memory rate limiter (app/rate_limiter.py) - allows this many calls to
# Mistral per window, then rejects with a 429 until the window resets.
# Mistral doesn't publish exact free-tier numbers; check your real limit at
# https://console.mistral.ai -> Admin Panel -> API -> Limits. If this key is
# also used by other live apps, set these to roughly this app's *share* of
# that limit (e.g. a third, for 3 apps), not the whole thing — rate limits
# are enforced per workspace, shared across every key in it, not per key.
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=10
